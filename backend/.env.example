# ============================================================
# EduFlow — variáveis de ambiente do backend
# Copie para .env e preencha com os valores reais.
# NUNCA versione o .env preenchido (já está no .gitignore).
# ============================================================

# Banco de dados
DATABASE_URL=postgresql+asyncpg://usuario:senha@localhost:5432/eduflow_db

# Aplicação
BASE_URL=https://seu-dominio.com
WEBHOOK_VERIFY_TOKEN=defina_um_token

# Evolution API (WhatsApp)
# EVOLUTION_API_KEY é obrigatória: o backend falha no startup sem ela.
EVOLUTION_API_URL=http://SEU_HOST_EVOLUTION:8080
EVOLUTION_API_KEY=coloque_a_apikey_do_evolution_aqui
EDUFLOW_WEBHOOK_URL=https://seu-dominio.com/api/evolution/webhook

# OpenAI
OPENAI_API_KEY=sk-...

# Twilio
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+550000000000

# ElevenLabs
ELEVENLABS_API_KEY=sk_...
ELEVENLABS_WEBHOOK_SECRET=wsec_...
ELEVENLABS_VOICE_ID=...
ELEVENLABS_AGENT_ID=agent_...
VOICE_AI_ENABLED=false

# Instagram
INSTAGRAM_APP_ID=...
INSTAGRAM_APP_SECRET=...

# Composio
COMPOSIO_API_KEY=...

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# SMTP (Gmail App Password)
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua_app_password
